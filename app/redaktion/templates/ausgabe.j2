{% extends "base.j2" %}
{% block title %}{{ e.title }}{% endblock %}
{% block content %}
{% set st = e.state %}
<p><a href="/">Übersicht</a></p>
<h1>{{ e.title }}</h1>
<p class="muted">{{ e.rel }} · Sendedatum {{ e.date }}</p>

<section class="panel status">
  <p><strong>Nächste Stufe: {{ st.next.id }} {{ st.next.name }}</strong>{% if st.next.note %} ({{ st.next.note }}){% endif %}</p>
  {% if active %}
    <p><span class="pill run">läuft</span> <a href="/lauf/{{ active }}">Lauf #{{ active }} ansehen</a></p>
  {% elif st.gate_waiting %}
    <p>Prüfpunkt Stufe {{ st.gate_waiting }} wartet auf dein Urteil. Mit dem Urteil startet der Runner die nächste Stufe.</p>
    <form method="post" action="/ausgabe/{{ e.name }}/lauf" class="row">
      <button name="aktion" value="ja">Ja, weiter</button>
    </form>
    <form method="post" action="/ausgabe/{{ e.name }}/lauf" class="row">
      <input name="text" placeholder="Ein bis zwei Sätze, was sich ändern soll" required>
      <button name="aktion" value="geaendert" class="secondary">Geändert</button>
    </form>
    <form method="post" action="/ausgabe/{{ e.name }}/lauf" class="row">
      <select name="zurueck">{% for b in back_to %}<option>{{ b }}</option>{% endfor %}</select>
      <button name="aktion" value="blockiert" class="danger">Blockiert, zurück</button>
    </form>
  {% elif st.next.id == "5b" %}
    <p>Du schreibst den Text in <code>index.qmd</code> in deinem Editor.</p>
    {% if st.empty_parts %}<p class="muted">Noch ohne Text: {{ st.empty_parts|join(", ") }}</p>{% endif %}
    <form method="post" action="/ausgabe/{{ e.name }}/lauf"><button name="aktion" value="text_fertig" {% if st.empty_parts %}disabled{% endif %}>Text fertig, Prüfung starten</button></form>
  {% elif st.next.id == "9" %}
    <p><a class="button" href="/ausgabe/{{ e.name }}/freigabe">Zur Freigabe</a></p>
  {% elif st.next.id == "10" %}
    <p><a class="button" href="/ausgabe/{{ e.name }}/versand">Entwurf für Buttondown</a></p>
  {% elif st.next.id == "fertig" %}
    <p>Alle Stufen haben dein Ja.</p>
  {% else %}
    <form method="post" action="/ausgabe/{{ e.name }}/lauf" class="row">
      {% if st.next.id == "7" %}<input name="quelle" placeholder="Datenquelle für die Grafik (Datei oder Paket)">{% endif %}
      <button name="aktion" value="start">Stufe {{ st.next.id }} {{ st.next.name }} starten</button>
    </form>
  {% endif %}
</section>

<div class="two">
  <section>
    <nav class="tabs">
      {% for f in present %}<a href="?datei={{ f }}" class="{% if f == shown %}on{% endif %}">{{ f }}</a>{% endfor %}
    </nav>
    {% if shown %}<article class="doc">{{ shown_text|md|safe }}</article>{% else %}<p class="muted">Noch keine Ausgabe einer Stufe.</p>{% endif %}
  </section>
  <section>
    <h2>index.qmd</h2>
    <article class="doc preview">{{ preview|md|safe }}</article>
  </section>
</div>

<section>
  <h2>Prüfpunkte</h2>
  <ul class="gates">{% for g in st.gates %}<li>{{ g[2:] }}</li>{% else %}<li class="muted">noch keine</li>{% endfor %}</ul>
  {% if recent %}<h2>Läufe</h2><ul>{% for r in recent %}<li><a href="/lauf/{{ r.id }}">#{{ r.id }}</a> Stufe {{ r.stage }}, {{ r.status }}, {{ r.started|zeit }}</li>{% endfor %}</ul>{% endif %}
</section>
{% endblock %}
